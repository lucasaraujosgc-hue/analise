# Porta do servidor
PORT=3000

# Pastas de dados (no Docker ficam em volumes)
# DATA_DIR=./data
# STORAGE_DIR=./storage

# Robô gratuito do PGMEI (consulta de DAS em aberto e DASN-SIMEI)
# Caminho do Chrome/Chromium; se vazio, o sistema procura nos locais padrão.
# CHROME_PATH=/usr/bin/chromium-browser
# true = navegador invisível. Rodando no seu computador, use false para ver o
# navegador e resolver o captcha manualmente se o portal pedir.
PGMEI_HEADLESS=true

# Variáveis do Google AI Studio (template original; não usadas pelo sistema hoje)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
