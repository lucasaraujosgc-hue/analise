# Porta do servidor
PORT=3000

# Pastas de dados (no Docker ficam em volumes)
# DATA_DIR=./data
# STORAGE_DIR=./storage

# Robô gratuito do PGMEI (consulta de DAS em aberto e DASN-SIMEI)
# Caminho do Chrome/Chromium; se vazio, o sistema procura nos locais padrão.
# CHROME_PATH=/usr/lib/chromium/chromium
# false (recomendado) = Chrome com janela; em servidor sem monitor ele roda numa
# tela virtual (Xvfb), que a verificação anti-robô da Receita barra bem menos.
# true = modo headless (invisível), mais leve porém mais bloqueado.
PGMEI_HEADLESS=false

# Variáveis do Google AI Studio (template original; não usadas pelo sistema hoje)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"

# Opcional: proxy no Brasil para os robôs (PGMEI e CND). Os sites da Receita
# costumam não responder para servidores fora do Brasil.
# RECEITA_PROXY=http://usuario:senha@ip-do-proxy:porta
